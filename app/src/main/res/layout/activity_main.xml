<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#101418">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="#161B20"
        app:title="@string/app_name" app:titleTextColor="#FFFFFF" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="250dp">
        <androidx.camera.view.PreviewView android:id="@+id/previewView"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <com.lim.rppg.OverlayView android:id="@+id/overlay"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="10dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_margin="4dp" app:cardBackgroundColor="#1A2026" app:cardCornerRadius="12dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="rPPG 심박" android:textColor="#9AA4AE" android:textSize="12sp" />
                    <TextView android:id="@+id/bpmText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textColor="#FF5C7A" android:textSize="34sp" android:textStyle="bold" />
                    <TextView android:id="@+id/bpmTextSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="BPM" android:textColor="#9AA4AE" android:textSize="11sp" android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_margin="4dp" app:cardBackgroundColor="#1A2026" app:cardCornerRadius="12dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="워치 심박" android:textColor="#9AA4AE" android:textSize="12sp" />
                    <TextView android:id="@+id/watchText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textColor="#4FC3F7" android:textSize="34sp" android:textStyle="bold" />
                    <TextView android:id="@+id/watchTextSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="미연동" android:textColor="#9AA4AE" android:textSize="11sp" android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_margin="4dp" app:cardBackgroundColor="#1A2026" app:cardCornerRadius="12dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="스트레스" android:textColor="#9AA4AE" android:textSize="12sp" />
                    <TextView android:id="@+id/stressText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textColor="#66FFB3" android:textSize="34sp" android:textStyle="bold" />
                    <TextView android:id="@+id/stressTextSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="30초 후 계산" android:textColor="#9AA4AE" android:textSize="11sp" android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <ProgressBar android:id="@+id/stressBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginHorizontal="6dp"
                android:layout_marginTop="4dp" android:max="100" android:progress="0" />

            <TextView android:id="@+id/qualityText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center" android:textColor="#9AA4AE" android:textSize="12sp" />

            <TextView android:id="@+id/constitutionText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:background="#1A2026" android:padding="10dp"
                android:textColor="#E0E6EA" android:textSize="13sp" />

            <com.lim.rppg.SignalView android:id="@+id/signalView"
                android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="6dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="심박 비교  ━ rPPG   ━ 워치" android:textColor="#9AA4AE" android:textSize="12sp" />
            <com.lim.rppg.CompareChartView android:id="@+id/compareChart"
                android:layout_width="match_parent" android:layout_height="120dp" />
            <TextView android:id="@+id/compareText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="#E0E6EA" android:textSize="13sp" />

            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:textColor="#E0E6EA" android:textSize="14sp" />
            <ProgressBar android:id="@+id/sessionProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp" android:max="100" />

            <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/start" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:gravity="center" android:text="@string/disclaimer" android:textColor="#707880" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
